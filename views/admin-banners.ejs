<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .admin-banners-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
      margin-top: 100px;
    }

    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .admin-header h1 {
      font-size: 2rem;
      color: rgb(18, 21, 32);
      margin: 0;
    }

    .btn-new {
      background: rgb(18, 21, 32);
      color: #fff;
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.3s;
    }

    .btn-new:hover {
      background: #0f1419;
    }

    .banners-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .banner-card {
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      overflow: hidden;
      transition: all 0.3s;
    }

    .banner-card:hover {
      box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    }

    .banner-card-image {
      width: 100%;
      height: 150px;
      background: #f0f0f0;
      object-fit: cover;
    }

    .banner-card-content {
      padding: 1.5rem;
    }

    .banner-card-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: rgb(18, 21, 32);
      margin-bottom: 0.5rem;
    }

    .banner-card-text {
      font-size: 0.9rem;
      color: #666;
      line-height: 1.5;
      margin-bottom: 0.75rem;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .banner-card-pages {
      font-size: 0.85rem;
      color: #888;
      margin-bottom: 1rem;
      font-weight: 500;
    }

    .banner-card-actions {
      display: flex;
      gap: 0.5rem;
    }

    .btn-edit, .btn-delete {
      flex: 1;
      padding: 0.5rem 1rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 500;
      font-size: 0.85rem;
      transition: all 0.3s;
    }

    .btn-edit {
      background: #e3f2fd;
      color: rgb(18, 21, 32);
    }

    .btn-edit:hover {
      background: #bbdefb;
    }

    .btn-delete {
      background: #ffebee;
      color: #c62828;
    }

    .btn-delete:hover {
      background: #ffcdd2;
    }

    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
    }

    .modal.show {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-content {
      background: #fff;
      padding: 2rem;
      border-radius: 8px;
      width: 90%;
      max-width: 600px;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .modal-header h2 {
      margin: 0;
      color: rgb(18, 21, 32);
    }

    .close-modal {
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: #666;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      font-weight: 600;
      color: rgb(18, 21, 32);
      margin-bottom: 0.5rem;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #d0d0d0;
      border-radius: 4px;
      font-size: 1rem;
      font-family: inherit;
    }

    .form-group input[type="color"] {
      width: 100%;
      height: 50px;
      cursor: pointer;
    }

    .form-group textarea {
      resize: vertical;
      min-height: 100px;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      border-color: rgb(18, 21, 32);
      outline: none;
    }

    .checkbox-group {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin-top: 0.75rem;
    }

    .checkbox-item {
      display: flex;
      align-items: center;
    }

    .checkbox-item input {
      width: auto;
      margin-right: 0.75rem;
    }

    .checkbox-item label {
      margin: 0;
      font-weight: 400;
      color: #333;
    }

    .form-actions {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
    }

    .btn-save, .btn-cancel {
      flex: 1;
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 500;
      font-size: 1rem;
      transition: all 0.3s;
    }

    .btn-save {
      background: rgb(18, 21, 32);
      color: #fff;
    }

    .btn-save:hover {
      background: #0f1419;
    }

    .btn-cancel {
      background: #e0e0e0;
      color: #333;
    }

    .btn-cancel:hover {
      background: #bdbdbd;
    }

    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: #888;
    }

    .empty-state-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      opacity: 0.5;
    }

    @media (max-width: 768px) {
      .admin-header {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
      }

      .banners-grid {
        grid-template-columns: 1fr;
      }

      .modal-content {
        width: 95%;
        padding: 1.5rem;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="admin-banners-container">
    <div class="admin-header">
      <h1>Gestionar Banners</h1>
      <button class="btn-new" id="btnNuevoBanner">+ Nuevo Banner</button>
    </div>

    <% if (banners && banners.length > 0) { %>
      <div class="banners-grid">
        <% banners.forEach(banner => { %>
          <div class="banner-card">
            <img src="<%= banner.imagen %>" alt="<%= banner.titulo %>" class="banner-card-image" onerror="this.src='/img/noticia-default.jpg'">
            <div class="banner-card-content">
              <div class="banner-card-title"><%= banner.titulo %></div>
              <div class="banner-card-text"><%= banner.texto %></div>
              <div class="banner-card-pages">Páginas: <%= banner.paginas.join(', ') %></div>
              <div class="banner-card-actions">
                <button class="btn-edit" onclick="editarBanner('<%= banner.id %>')">Editar</button>
                <button class="btn-delete" onclick="eliminarBanner('<%= banner.id %>')">Eliminar</button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">📋</div>
        <p>No hay banners creados aún</p>
        <p>Haz clic en "Nuevo Banner" para crear uno</p>
      </div>
    <% } %>
  </div>

  <!-- Modal para crear/editar banner -->
  <div class="modal" id="modalBanner">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="modalTitle">Nuevo Banner</h2>
        <button class="close-modal" onclick="cerrarModal()">×</button>
      </div>

      <form id="bannerForm">
        <div class="form-group">
          <label for="titulo">Título *</label>
          <input type="text" id="titulo" name="titulo" required>
        </div>

        <div class="form-group">
          <label for="texto">Texto *</label>
          <textarea id="texto" name="texto" required></textarea>
        </div>

        <div class="form-group">
          <label for="imagen">URL de la imagen *</label>
          <input type="text" id="imagen" name="imagen" placeholder="/img/sobre-nosotros.jpg" required>
          <small style="color: #888; display: block; margin-top: 0.5rem;">Sube la imagen a <b>public/img/</b> y coloca la ruta aquí</small>
        </div>

        <div class="form-group">
          <label for="boton_url">URL del botón *</label>
          <input type="text" id="boton_url" name="boton_url" placeholder="#seccion-id" required>
        </div>

        <div class="form-group">
          <label for="boton_texto">Texto del botón *</label>
          <input type="text" id="boton_texto" name="boton_texto" value="Ver más" required>
        </div>

        <div class="form-group">
          <label for="color_fondo">Color de fondo</label>
          <input type="color" id="color_fondo" name="color_fondo" value="#121520">
          <small style="color: #888; display: block; margin-top: 0.5rem;">Color del área de contenido</small>
        </div>

        <div class="form-group">
          <label for="color_texto">Color del texto</label>
          <input type="color" id="color_texto" name="color_texto" value="#ffffff">
          <small style="color: #888; display: block; margin-top: 0.5rem;">Color del texto y botón</small>
        </div>

        <div class="form-group">
          <label>Mostrar en páginas *</label>
          <div class="checkbox-group">
            <div class="checkbox-item">
              <input type="checkbox" id="pagina_inicio" name="paginas" value="inicio">
              <label for="pagina_inicio" style="margin: 0;">Inicio</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" id="pagina_noticias" name="paginas" value="noticias">
              <label for="pagina_noticias" style="margin: 0;">Noticias</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" id="pagina_servicios" name="paginas" value="servicios">
              <label for="pagina_servicios" style="margin: 0;">Servicios</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" id="pagina_sobre_nosotros" name="paginas" value="sobre-nosotros">
              <label for="pagina_sobre_nosotros" style="margin: 0;">Sobre Nosotros</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" id="pagina_contacto" name="paginas" value="contacto">
              <label for="pagina_contacto" style="margin: 0;">Contacto</label>
            </div>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-save" id="btnGuardar">Guardar Banner</button>
          <button type="button" class="btn-cancel" onclick="cerrarModal()">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    let bannerActual = null;

    // Abrir modal para nuevo banner
    document.getElementById('btnNuevoBanner').addEventListener('click', () => {
      bannerActual = null;
      document.getElementById('modalTitle').textContent = 'Nuevo Banner';
      document.getElementById('bannerForm').reset();
      document.querySelectorAll('input[name="paginas"]').forEach(cb => cb.checked = false);
      document.getElementById('modalBanner').classList.add('show');
    });

    // Editar banner
    function editarBanner(id) {
      fetch(`/api/banners/${id}`)
        .then(res => res.json())
        .then(banner => {
          bannerActual = banner;
          document.getElementById('modalTitle').textContent = 'Editar Banner';
          document.getElementById('titulo').value = banner.titulo;
          document.getElementById('texto').value = banner.texto;
          document.getElementById('imagen').value = banner.imagen;
          document.getElementById('boton_url').value = banner.boton_url;
          document.getElementById('boton_texto').value = banner.boton_texto;
          document.getElementById('color_fondo').value = banner.color_fondo || '#121520';
          document.getElementById('color_texto').value = banner.color_texto || '#ffffff';
          
          // Marcar las páginas seleccionadas
          document.querySelectorAll('input[name="paginas"]').forEach(cb => {
            cb.checked = banner.paginas.includes(cb.value);
          });
          
          document.getElementById('modalBanner').classList.add('show');
        });
    }

    // Cerrar modal
    function cerrarModal() {
      document.getElementById('modalBanner').classList.remove('show');
      bannerActual = null;
    }

    // Guardar banner
    document.getElementById('bannerForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const titulo = document.getElementById('titulo').value;
      const texto = document.getElementById('texto').value;
      const imagen = document.getElementById('imagen').value;
      const boton_url = document.getElementById('boton_url').value;
      const boton_texto = document.getElementById('boton_texto').value;
      const color_fondo = document.getElementById('color_fondo').value;
      const color_texto = document.getElementById('color_texto').value;
      const paginas = Array.from(document.querySelectorAll('input[name="paginas"]:checked')).map(cb => cb.value);

      if (paginas.length === 0) {
        alert('Por favor selecciona al menos una página');
        return;
      }

      const url = bannerActual ? `/api/banners/${bannerActual.id}` : '/api/banners';
      const method = bannerActual ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ titulo, texto, imagen, boton_url, boton_texto, color_fondo, color_texto, paginas })
        });
        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          alert('Error al guardar el banner: ' + (data.error || 'desconocido'));
        }
      } catch (error) {
        alert('Error de conexión: ' + error.message);
      }
    });

    // Eliminar banner
    function eliminarBanner(id) {
      if (confirm('¿Estás seguro de que deseas eliminar este banner?')) {
        fetch(`/api/banners/${id}`, {
          method: 'DELETE'
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            location.reload();
          } else {
            alert('Error al eliminar');
          }
        })
        .catch(err => alert('Error: ' + err.message));
      }
    }

    // Cerrar modal al hacer clic fuera
    document.getElementById('modalBanner').addEventListener('click', (e) => {
      if (e.target.id === 'modalBanner') {
        cerrarModal();
      }
    });
  </script>
</body>
</html>
