<%- include('partials/header') %>

<main style="display: flex; justify-content: center; align-items: flex-start; min-height: 100vh; padding-top: 120px; padding-bottom: 80px; box-sizing: border-box; background: #f6f7f8;">
  <section style="background: #fff; border: 1px solid #e0e0e0; max-width: 900px; width: 100%; padding: 2.5rem 2rem; margin: 0 auto;">
    <h1 style="font-size: 2rem; font-weight: 700; color: #222; margin-bottom: 0.5rem;">Panel de Administración</h1>
    <p style="color: #666; margin-bottom: 2rem;">Gestiona el contenido de tu sitio web</p>

    <!-- Sección de navegación de admin -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
      <a href="/admin" style="display: block; padding: 1.5rem; background: rgb(18, 21, 32); color: #fff; text-decoration: none; border-radius: 8px; text-align: center; transition: background 0.3s;">
        <h3 style="margin: 0 0 0.5rem 0; font-size: 1.2rem;">📰 Noticias</h3>
        <p style="margin: 0; font-size: 0.9rem; opacity: 0.9;">Gestionar noticias</p>
      </a>
      
      <a href="/admin-servicios" style="display: block; padding: 1.5rem; background: #0A66C2; color: #fff; text-decoration: none; border-radius: 8px; text-align: center; transition: background 0.3s;">
        <h3 style="margin: 0 0 0.5rem 0; font-size: 1.2rem;">🛠️ Servicios</h3>
        <p style="margin: 0; font-size: 0.9rem; opacity: 0.9;">Gestionar servicios</p>
      </a>
      <a href="/admin-sobre-nosotros" style="display: block; padding: 1.5rem; background: #F4A300; color: #fff; text-decoration: none; border-radius: 8px; text-align: center; transition: background 0.3s;">
        <h3 style="margin: 0 0 0.5rem 0; font-size: 1.2rem;">👤 Sobre Nosotros</h3>
        <p style="margin: 0; font-size: 0.9rem; opacity: 0.9;">Editar sección institucional</p>
      </a>
      <a href="/admin/banners" style="display: block; padding: 1.5rem; background: #8B5CF6; color: #fff; text-decoration: none; border-radius: 8px; text-align: center; transition: background 0.3s;">
        <h3 style="margin: 0 0 0.5rem 0; font-size: 1.2rem;">🎨 Banners</h3>
        <p style="margin: 0; font-size: 0.9rem; opacity: 0.9;">Gestionar banners dinámicos</p>
      </a>
    </div>

    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 2rem 0;">

    <h2 style="font-size: 1.5rem; font-weight: 700; color: #222; margin-bottom: 1.5rem;">Administrar Noticias</h2>
    
    <!-- Formulario para crear/editar noticia -->
    <form id="noticiaForm" style="margin-bottom: 3rem; padding: 1.5rem; background: #f6f7f8; border-radius: 4px;">
      <input type="hidden" id="noticiaId">
      
      <div style="margin-bottom: 1.5rem;">
        <label for="titulo" style="display: block; color: #222; font-weight: 500; margin-bottom: 0.5rem;">Título</label>
        <input type="text" id="titulo" name="titulo" required style="width: 100%; padding: 0.75rem; border: 1px solid #e0e0e0; border-radius: 4px; font-size: 1rem;">
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label for="subtitulo" style="display: block; color: #222; font-weight: 500; margin-bottom: 0.5rem;">Subtítulo (opcional)</label>
        <input type="text" id="subtitulo" name="subtitulo" style="width: 100%; padding: 0.75rem; border: 1px solid #e0e0e0; border-radius: 4px; font-size: 1rem;" placeholder="Descripción corta o resumen">
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label for="categoria" style="display: block; color: #222; font-weight: 500; margin-bottom: 0.5rem;">Categoría</label>
        <input type="text" id="categoria" name="categoria" style="width: 100%; padding: 0.75rem; border: 1px solid #e0e0e0; border-radius: 4px; font-size: 1rem;" placeholder="ej: Regulaciones, Noticias, General">
      </div>
      
      <div style="margin-bottom: 1.5rem;">
        <label for="imagen" style="display: block; color: #222; font-weight: 500; margin-bottom: 0.5rem;">Imagen (URL)</label>
        <input type="text" id="imagen" name="imagen" style="width: 100%; padding: 0.75rem; border: 1px solid #e0e0e0; border-radius: 4px; font-size: 1rem;">
      </div>
      
      <div style="margin-bottom: 1.5rem;">
        <label for="contenido" style="display: block; color: #222; font-weight: 500; margin-bottom: 0.5rem;">Contenido</label>
        <textarea id="contenido" name="contenido" rows="10" style="width: 100%; padding: 0.75rem; border: 1px solid #e0e0e0; border-radius: 4px; font-size: 1rem; resize: vertical;"></textarea>
      </div>
      
      <button type="submit" style="padding: 0.75rem 2rem; background: rgb(18, 21, 32); color: #fff; border: none; border-radius: 4px; font-weight: 500; font-size: 1rem; cursor: pointer; margin-right: 0.5rem;">Guardar noticia</button>
      <button type="button" id="cancelarBtn" style="padding: 0.75rem 2rem; background: #888; color: #fff; border: none; border-radius: 4px; font-weight: 500; font-size: 1rem; cursor: pointer; display: none;">Cancelar</button>
    </form>
    
    <!-- Lista de noticias -->
    <h2 style="font-size: 1.5rem; font-weight: 700; color: #222; margin-bottom: 1rem;">Noticias existentes</h2>
    <div id="listaNoticias">
      <% if (noticias.length === 0) { %>
        <p style="color: #888; text-align: center; padding: 2rem 0;">No hay noticias disponibles.</p>
      <% } else { %>
        <% noticias.forEach(noticia => { %>
          <div style="margin-bottom: 1.5rem; padding: 1.5rem; border: 1px solid #e0e0e0; border-radius: 4px;">
            <h3 style="color: rgb(18, 21, 32); font-size: 1.2rem; margin-bottom: 0.5rem;"><%= noticia.titulo %></h3>
            <p style="color: #888; font-size: 0.9rem; margin-bottom: 1rem;"><%= new Date(noticia.fecha).toLocaleDateString('es-UY') %></p>
            <p style="color: #555; line-height: 1.6; margin-bottom: 1rem;"><%- noticia.contenido.replace(/<[^>]*>/g, '').substring(0, 300) %>...</p>
            <button data-noticia='<%= JSON.stringify({id: noticia.id, titulo: noticia.titulo || "", subtitulo: noticia.subtitulo || "", categoria: noticia.categoria || "", contenido: noticia.contenido || "", imagen: noticia.imagen || ""}) %>' onclick="editarNoticia(this)" style="padding: 0.5rem 1rem; background: #007bff; color: #fff; border: none; border-radius: 4px; cursor: pointer;">Editar</button>
            <button data-id="<%= noticia.id %>" onclick="eliminarNoticia(this)" style="padding: 0.5rem 1rem; background: #dc3545; color: #fff; border: none; border-radius: 4px; cursor: pointer;">Eliminar</button>
          </div>
        <% }) %>
      <% } %>
    </div>
    
    <a href="/" style="display: inline-block; margin-top: 2rem; padding: 0.75rem 1.5rem; background: rgb(18, 21, 32); color: #fff; text-decoration: none; border-radius: 4px; font-weight: 500;">Volver al inicio</a>
  </section>
</main>

<script src="https://cdn.tiny.cloud/1/49inuovdjt0qoes0sv0404upszrzvo63al5fvkly0aj068x7/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
// Inicializar TinyMCE
tinymce.init({
  selector: '#contenido',
  plugins: 'link',
  toolbar: 'bold link',
  menubar: false,
  statusbar: false,
  height: 300
});

let modoEdicion = false;

// Cuando el DOM esté listo, vincular eventos
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('noticiaForm');
  if (form) {
    form.addEventListener('submit', handleFormSubmit);
  }
  
  const cancelBtn = document.getElementById('cancelarBtn');
  if (cancelBtn) {
    cancelBtn.addEventListener('click', handleCancel);
  }
});

async function handleFormSubmit(e) {
  e.preventDefault();
  
  const id = document.getElementById('noticiaId').value;
  const titulo = document.getElementById('titulo').value.trim();
  const subtitulo = document.getElementById('subtitulo').value.trim();
  const categoria = document.getElementById('categoria').value.trim();
  const imagen = document.getElementById('imagen').value.trim();
  
  let contenido = '';
  
  // Obtener contenido desde TinyMCE si está disponible
  if (window.tinymce && tinymce.get('contenido')) {
    contenido = tinymce.get('contenido').getContent({ format: 'html' });
    console.log('Contenido desde TinyMCE:', contenido);
  } else {
    contenido = document.getElementById('contenido').value;
    console.log('Contenido desde textarea:', contenido);
  }
  
  // No hacer trim al contenido HTML para preservar etiquetas
  if (!contenido || contenido === '<p></p>' || contenido === '<p><br></p>') {
    contenido = '';
  }
  
  console.log('Enviando:', { id, titulo, subtitulo, categoria, contenido, imagen });
  
  if (!titulo || !contenido) {
    alert('El título y contenido son obligatorios');
    return;
  }
  
  const url = modoEdicion ? `/api/noticias/${id}` : '/api/noticias';
  const method = modoEdicion ? 'PUT' : 'POST';
  
  try {
    const response = await fetch(url, {
      method: method,
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ titulo, subtitulo, categoria, contenido, imagen })
    });
    
    if (!response.ok) {
      throw new Error('HTTP ' + response.status);
    }
    
    const data = await response.json();
    console.log('Respuesta:', data);
    
    if (data.success) {
      alert(modoEdicion ? 'Noticia actualizada' : 'Noticia creada');
      window.location.reload(true);
    } else {
      alert('Error: ' + (data.message || 'desconocido'));
    }
  } catch (error) {
    console.error('Error:', error);
    alert('Error: ' + error.message);
  }
}

function handleCancel() {
  document.getElementById('noticiaId').value = '';
  document.getElementById('titulo').value = '';
  document.getElementById('subtitulo').value = '';
  document.getElementById('categoria').value = '';
  document.getElementById('imagen').value = '';
  
  if (tinymce.get('contenido')) {
    tinymce.get('contenido').setContent('');
  } else {
    document.getElementById('contenido').value = '';
  }
  
  document.getElementById('cancelarBtn').style.display = 'none';
  modoEdicion = false;
}

function editarNoticia(button) {
  try {
    const noticia = button.dataset.noticia;
    console.log('dataset.noticia raw:', noticia);
    
    const data = JSON.parse(noticia);
    console.log('Datos parseados:', data);
    
    // Llenar formulario
    document.getElementById('noticiaId').value = data.id || '';
    document.getElementById('titulo').value = data.titulo || '';
    document.getElementById('subtitulo').value = data.subtitulo || '';
    document.getElementById('categoria').value = data.categoria || '';
    document.getElementById('imagen').value = data.imagen || '';
    
    console.log('Imagen value después de setear:', document.getElementById('imagen').value);
    
    // Llenar contenido en TinyMCE
    if (window.tinymce && tinymce.get('contenido')) {
      tinymce.get('contenido').setContent(data.contenido || '');
      console.log('Contenido cargado en TinyMCE');
    } else {
      document.getElementById('contenido').value = data.contenido || '';
      console.log('Contenido cargado en textarea');
    }
    
    document.getElementById('cancelarBtn').style.display = 'inline-block';
    modoEdicion = true;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  } catch (error) {
    console.error('Error al editar:', error);
    alert('Error al cargar la noticia: ' + error.message);
  }
}

async function eliminarNoticia(button) {
  const id = button.dataset.id;
  if (!confirm('¿Estás seguro de que quieres eliminar esta noticia?')) {
    return;
  }
  
  try {
    const response = await fetch(`/api/noticias/${id}`, {
      method: 'DELETE'
    });
    
    const data = await response.json();
    
    if (data.success) {
      alert('Noticia eliminada');
      window.location.reload(true);
    } else {
      alert('Error: ' + (data.message || ''));
    }
  } catch (error) {
    alert('Error: ' + error.message);
  }
}


</script>

<%- include('partials/footer') %>
