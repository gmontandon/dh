<%- include('partials/header') %>

<style>
  .noticias-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .noticias-header h1 {
    font-size: 48px;
    font-weight: 600;
    font-family: 'Segoe UI', Tahoma, sans-serif;
    color: #1a1a1a;
    text-align: center;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .noticias-header p {
    font-size: 16px;
    line-height: 1.6;
    font-weight: 400;
    color: #333;
    font-family: 'Segoe UI', Tahoma, sans-serif;
    margin-bottom: 20px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    white-space: normal;
    word-break: break-words;
  }

  p.subtitle {
    font-size: 18px;
    font-weight: 400;
    color: #666;
    text-align: center;
    margin-bottom: 1rem;
  }
  .noticia-card {
    display: flex;
    margin-bottom: 0;
    background: #fff;
    border-radius: 0 8px 8px 0;
    overflow: hidden;
    height: 350px;
  }
  .noticia-card:nth-child(even) {
    flex-direction: row-reverse;
    border-radius: 8px 0 0 8px;
  }
  .noticia-image {
    flex: 0 0 50%;
    background: #f0f0f0;
    min-height: 350px;
  }
  .noticia-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .noticia-content {
    flex: 0 0 50%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .noticia-content h2 {
    color: rgb(18, 21, 32);
    font-size: 1.6rem;
    margin-bottom: 0.1rem;
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .noticia-content p {
    color: #555;
    line-height: 1.6;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
  }
  .noticia-content .fecha {
    color: #888;
    font-size: 0.9rem;
    margin-bottom: 0.125rem;
    margin-top: 0;
  }
  .ver-mas-btn {
    display: inline-flex;
    align-items: center;
    color: rgb(18, 21, 32);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 0.95rem;
    align-self: flex-start;
    padding: 0.75rem 1.5rem;
    border: 2px solid rgb(18, 21, 32);
    border-radius: 4px;
  }
  .ver-mas-btn:after {
    content: " ›";
    margin-left: 0.25rem;
    font-size: 1.2rem;
  }
  .ver-mas-btn:hover {
    background: rgb(18, 21, 32);
    color: #fff;
  }

  @media (max-width: 768px) {
    .noticia-card {
      flex-direction: column !important;
      height: auto;
    }
    .noticia-image {
      flex: 0 0 250px;
      min-height: 250px;
    }
    .noticia-content {
      flex: 0 0 auto;
    }
    .noticia-content h2 {
      font-size: 1.3rem;
    }
  }
</style>

<main style="padding-top: 120px; padding-bottom: 80px; background: #fff; min-height: 100vh;">
  <div class="noticias-header">
    <h1>Noticias</h1>
    <p class="subtitle">Mantente al día con las últimas novedades y actualizaciones de David Henderson Grupo. Descubre nuestras historias, logros y avances en el sector.</p>
  </div>
  
  <% if (noticias.length === 0) { %>
    <p style="color: #888; text-align: center; padding: 2rem 0;">No hay noticias disponibles en este momento.</p>
  <% } else { %>
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 2rem;">
      <% noticias.slice(0,5).forEach((noticia, index) => { %>
        <div class="noticia-card">
          <div class="noticia-image">
            <img src="<%= noticia.imagen || '/img/noticia-default.jpg' %>" alt="<%= noticia.titulo %>">
          </div>
          <div class="noticia-content">
            <h2><%= noticia.titulo.length > 70 ? noticia.titulo.substring(0, 70) + '...' : noticia.titulo %></h2>
            <p class="fecha" style="display: flex; justify-content: space-between; align-items: center;">
              <span style="background: rgb(18, 21, 32); color: #fff; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.8rem; font-weight: 500;"><%= noticia.categoria || 'General' %></span>
              <span><%= new Date(noticia.fecha).toLocaleDateString('es-UY') %></span>
            </p>
            <p><%- noticia.contenido.replace(/<[^>]*>/g, '').substring(0, 1200) %>...</p>
            <a href="/noticias/<%= noticia.id %>" class="ver-mas-btn">Ver más</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('partials/banners', { banners: banners || [] }) %>

<%- include('partials/footer') %>
