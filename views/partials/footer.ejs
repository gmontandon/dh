  <style>
    .site-footer {
      width: 100%;
      background: rgb(18, 21, 32);
      color: #fff;
      padding: 2rem;
      margin-top: auto;
      margin-bottom: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: ArbeitRegular, Helvetica, Arial, sans-serif;
    }
    .footer-logo-img {
      height: 30px;
      width: auto;
      filter: brightness(0) invert(1);
    }
    .footer-companies-centered {
      flex: 1;
      display: flex;
      justify-content: center;
    }
    .footer-icons {
      display: flex;
      gap: 1rem;
    }
    .footer-icons a {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .footer-icons svg {
      fill: #ccc;
    }
    .footer-companies {
      list-style: none;
      display: flex;
      gap: 1rem;
      margin: 0;
      padding: 0;
      font-size: 0.8rem;
    }
    .footer-companies a {
      color: #fff;
      text-decoration: none;
    }
    .footer-bottom {
      background: rgb(20, 24, 36);
      color: #fff;
      text-align: center;
      padding: 1rem;
      font-family: ArbeitRegular, Helvetica, Arial, sans-serif;
    }
    .footer-bottom p {
      margin: 0;
      font-size: 0.8rem;
    }
    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      margin: 0;
      overflow-x: hidden;
      word-spacing: 0.1em;
    }
    
    /* Media queries para móvil */
    @media (max-width: 768px) {
      .site-footer {
        flex-direction: column;
        gap: 1.5rem;
        padding: 1.5rem 1rem;
        text-align: center;
      }
      
      .footer-logo-img {
        height: 25px;
      }
      
      .footer-companies-centered {
        flex: none;
        width: 100%;
      }
      
      .footer-companies {
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.75rem;
      }
      
      .footer-icons {
        justify-content: center;
        width: 100%;
      }
      
      .footer-icons a {
        margin: 0 0.5rem;
      }
      
      .footer-icons svg {
        width: 20px;
        height: 20px;
      }
    }
    
    @media (max-width: 480px) {
      .site-footer {
        padding: 1rem 0.75rem;
        gap: 1rem;
      }
      
      .footer-logo-img {
        height: 22px;
      }
      
      .footer-companies {
        font-size: 0.7rem;
        gap: 0.25rem;
      }
      
      .footer-icons svg {
        width: 18px;
        height: 18px;
      }
      
      .footer-bottom {
        padding: 0.75rem;
      }
      
      .footer-bottom p {
        font-size: 0.7rem;
      }
    }
  </style>
