<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .main-nav ul {
      list-style: none;
      display: flex;
      gap: 2.2rem;
      margin: 0;
      padding: 0;
      align-items: center;
      justify-content: flex-end;
      background: rgb(18, 21, 32);
      border-radius: 0;
      border: none;
      border-bottom: 0 !important;
    }
    .main-nav li a {
      color: #fff;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-weight: 500;
      text-decoration: none !important;
      text-decoration-line: none !important;
      font-size: 0.98rem;
      padding: 0.28rem 1.1rem;
      border-radius: 0;
      border: 0 !important;
      border-bottom: 0 !important;
      border-image: none !important;
      transition: background 0.2s, color 0.2s, box-shadow 0.2s;
      letter-spacing: 0.5px;
      position: relative;
      background: transparent;
      box-shadow: none !important;
      height: 48px;
      display: flex;
      align-items: center;
      outline: none !important;
      overflow: hidden;
    }
    .main-nav li a:hover,
    .main-nav li a.active,
    .main-nav li a.selected {
      background: #fff;
      color: #333;
      box-shadow: 0 3px 0 #fff !important;
      border: 0 !important;
      border-bottom: 0 !important;
      outline: none !important;
      z-index: 2;
      padding: 0.28rem 1.1rem 0.28rem 1.1rem;
    }
    
    .main-nav li a:active {
      background: #fff;
      color: #333;
      box-shadow: 0 3px 0 #fff !important;
      border: 0 !important;
      border-bottom: 0 !important;
      outline: none !important;
    }
    
    .main-nav li a:hover::after,
    .main-nav li a.active::after,
    .main-nav li a.selected::after,
    .main-nav li a:focus::after,
    .main-nav li a:focus-visible::after {
      display: none !important;
    }
    .main-nav li a:focus {
      outline: none !important;
      box-shadow: 0 3px 0 #fff !important;
      border: 0 !important;
    }
    .main-nav li a:focus-visible {
      outline: none !important;
      box-shadow: 0 3px 0 #fff !important;
      border: 0 !important;
    }
    html, body {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      width: 100vw;
      min-height: 100vh;
    }
    header.mini-header {
      width: 100vw;
      background: rgb(18, 21, 32);
      color: #fff;
      padding: 2rem 0 0 0;
      margin: 0;
      border: none;
      border-bottom: 0 !important;
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 100;
      user-select: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
    }
    header .wrap {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      user-select: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
    }
    .logo-link {
      display: block;
      line-height: 0;
      cursor: pointer;
      transition: opacity 0.3s;
      margin-top: 0.5rem;
    }
    .logo-link:hover {
      opacity: 0.8;
    }
    .logo {
      height: 43px;
      width: auto;
      display: block;
      user-select: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      filter: brightness(0) invert(1);
    }
    
    /* Botón de Logout */
    .logout-btn {
      background: #FF6B6B;
      color: #fff;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 500;
      margin-left: auto;
      transition: background 0.3s;
      text-decoration: none;
      display: inline-block;
      height: auto;
    }
    
    .logout-btn:hover {
      background: #FF5252;
    }
    
    .logout-btn:active {
      background: #FF3838;
    }
    
    /* Hamburger Menu */
    .hamburger {
      display: none;
      flex-direction: column;
      cursor: pointer;
      gap: 5px;
      background: none;
      border: none;
      padding: 16px;
      margin-left: auto;
      overflow: visible;
      align-items: center;
      justify-content: center;
      outline: none !important;
    }
    
    .hamburger:focus {
      outline: none !important;
      box-shadow: none !important;
      border: none !important;
    }
    
    .hamburger:active {
      outline: none !important;
    }
    
    .hamburger span {
      width: 25px;
      height: 3px;
      background: #fff;
      border-radius: 3px;
      transition: all 0.3s ease;
      transform-origin: center;
    }
    
    .hamburger.active span:nth-child(1) {
      transform: rotate(45deg) translate(8px, 8px);
    }
    
    .hamburger.active span:nth-child(2) {
      opacity: 0;
    }
    
    .hamburger.active span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }
    
    @media (max-width: 600px) {
      header.mini-header {
        padding: 1rem 0 1rem 0;
      }
      header .wrap {
        max-width: 98vw;
        padding: 0 1vw;
        flex-wrap: nowrap;
        gap: 0;
      }
      .logo {
        height: 32px;
      }
      
      .hamburger {
        display: flex;
      }
      
      .main-nav {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: rgb(18, 21, 32);
        flex-direction: column;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
        margin-left: 0 !important;
        width: 100% !important;
        z-index: 99;
      }
      
      .main-nav.active {
        max-height: 400px;
      }
      
      .main-nav ul {
        flex-direction: column;
        gap: 0;
        width: 100%;
        padding: 0;
      }
      
      .main-nav li {
        width: 100%;
      }
      
      .main-nav li a {
        height: auto;
        padding: 1rem 1.5rem;
        font-size: 0.9rem;
        width: 100%;
        justify-content: flex-start;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }
      
      .main-nav li a:hover,
      .main-nav li a.active,
      .main-nav li a.selected {
        background: rgb(25, 28, 40);
        color: #fff;
        padding-left: 2rem;
      }
    }
    
    @media (max-width: 480px) {
      header.mini-header {
        padding: 0.75rem 0 0.75rem 0;
      }
      header .wrap {
        max-width: 100vw;
        padding: 0 0.75rem;
      }
      .logo {
        height: 28px;
      }
      
      .hamburger span {
        width: 22px;
        height: 2.5px;
      }
      
      .main-nav {
        top: 100%;
      }
      
      .main-nav li a {
        font-size: 0.85rem;
        padding: 0.85rem 1.25rem;
      }
      
      .main-nav li a:hover,
      .main-nav li a.active,
      .main-nav li a.selected {
        padding-left: 1.75rem;
      }
    }
  </style>
</head>
<body>
  <header class="mini-header">
    <div class="wrap">
      <a href="/" class="logo-link">
        <img src="/img/logo.svg" alt="Logo DH" class="logo" width="120" height="40">
      </a>
      <button class="hamburger" id="hamburger" aria-label="Menú">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="main-nav" id="mainNav" style="margin-left: 2.5rem; flex: 1;">
        <ul>
          <% 
            function isActive(section) {
              return typeof active !== 'undefined' && active === section ? 'active' : '';
            }
          %>
          <!-- Inicio eliminado -->
          <li><a href="/servicios" class="<%= isActive('servicios') %>">Servicios</a></li>
          <li><a href="/noticias" class="<%= isActive('noticias') %>">Noticias</a></li>
          <li><a href="/sobre-nosotros" class="<%= isActive('sobre-nosotros') %>">Sobre Nosotros</a></li>
          <li><a href="/contacto" class="<%= isActive('contacto') %>">Contacto</a></li>
          <!-- Agrega aquí nuevas secciones fácilmente -->
        </ul>
      </nav>
      
      <!-- Botón de Logout (si estamos autenticado) -->
      <% if (typeof currentPath !== 'undefined' && currentPath.includes('/admin')) { %>
        <a href="/logout" class="logout-btn" onclick="return confirm('¿Estás seguro de que quieres cerrar la sesión?')">🚪 Logout</a>
      <% } %>
    </div>
  </header>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const hamburger = document.getElementById('hamburger');
      const mainNav = document.getElementById('mainNav');
      
      // Toggle menu al hacer click en hamburger
      hamburger.addEventListener('click', function() {
        hamburger.classList.toggle('active');
        mainNav.classList.toggle('active');
      });
      
      // Cerrar menu al hacer click en un link
      const navLinks = mainNav.querySelectorAll('a');
      navLinks.forEach(link => {
        link.addEventListener('click', function() {
          hamburger.classList.remove('active');
          mainNav.classList.remove('active');
        });
      });
      
      // Cerrar menu al hacer click fuera
      document.addEventListener('click', function(event) {
        const isClickInside = mainNav.contains(event.target) || hamburger.contains(event.target);
        if (!isClickInside && mainNav.classList.contains('active')) {
          hamburger.classList.remove('active');
          mainNav.classList.remove('active');
        }
      });
    });
  </script>
